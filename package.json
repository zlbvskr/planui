{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "node --import tsx scripts/run-tests.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "test:regression": "node scripts/test-cleanup-regression.mjs",
    "test:ui-hygiene": "node --import tsx tests/ui-hygiene.spec.ts",
    "test:ui-primitives": "node --import tsx tests/ui-primitives.spec.ts",
    "test:stage1": "UI_FUNCTIONAL_ONLY=1 node --import tsx tests/stage1.spec.ts",
    "test:stage1-perf": "node tests/run-stage1-perf.mjs",
    "test:stage2": "node --import tsx tests/stage2.spec.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
